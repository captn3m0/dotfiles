### Input configuration
#
# Read `man 5 sway-input` for more information about this section.

# Touchpad configuration
input type:touchpad {
    # disable while typing
    dwt enabled
    tap enabled
    natural_scroll disabled
}

# Enable numlock by default
input type:keyboard {
  xkb_numlock enabled
  # Caps is now ctrl
  xkb_options caps:ctrl_modifier
  xkb_layout eu
}


